# OPTIONAL overrides. By default the app uses lib/firebase_options.dart, which
# `flutterfire configure` generates. Set these only to point a build at a
# different Firebase project (for example staging):
#
#   flutter run -d chrome --dart-define-from-file=.env
#   flutter build web --release --dart-define-from-file=.env
#
# .env is git-ignored.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
